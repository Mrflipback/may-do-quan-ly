# ===================================================================
# FILE MẪU - CHÉP FILE NÀY THÀNH ".env" RỒI ĐIỀN GIÁ TRỊ THẬT
# File .env đã được .gitignore chặn, sẽ KHÔNG bị đưa lên GitHub.
# ===================================================================

# Lấy ở Supabase: Project Settings > Data API > Project URL
VITE_SUPABASE_URL=

# Lấy ở Supabase: Project Settings > API Keys > publishable key (anon key)
# Khóa này được phép lộ ra trình duyệt. An toàn là nhờ Row Level Security.
VITE_SUPABASE_ANON_KEY=

# ===================================================================
# CẢNH BÁO AN TOÀN
# TUYỆT ĐỐI KHÔNG đặt "service_role key" hay "secret key" vào file này.
# Mọi biến bắt đầu bằng VITE_ đều bị nhúng vào mã nguồn trình duyệt
# và ai cũng xem được.
# ===================================================================
